# Keep Curator fully local. These settings disable its hosted Viewer and telemetry.
CURATOR_LOCAL_ONLY=1
CURATOR_VIEWER=0
TELEMETRY_ENABLED=false
CURATOR_CACHE_DIR=.curator_working

# Select named profiles declared in config.yaml.
GENERATION_PROFILE=glm
JUDGE_PROFILE=gemma_structured

# Gemma shared-gateway profiles. The selected structured profile disables
# provider thinking for compact schema-constrained judgments; select
# gemma_thinking only for an intentional reasoning experiment. MODEL is the
# served model ID; the credential belongs only in the ignored .env file.
MODEL=gemma-4-31b-it
# This identifies the underlying deployment and may differ from the gateway URL.
LLM_DEPLOYMENT_ID=gemma-4-31b-it-backend-v1
LLM_BASE_URL=http://127.0.0.1:3005/v1
LLM_API_KEY=replace-me

GLM_MODEL=GLM-5.2-NVFP4-FP8
# Keep this stable when only the port-forward URL changes. Change it when
# weights, quantization, tokenizer/template, parser, or serving semantics change.
GLM_DEPLOYMENT_ID=glm-5.2-backend-v1
GLM_BASE_URL=http://127.0.0.1:3005/v1
GLM_API_KEY=replace-me

NEMOTRON_MODEL=replace-me
NEMOTRON_DEPLOYMENT_ID=nemotron-deployment-v1
NEMOTRON_BASE_URL=http://127.0.0.1:8001/v1
NEMOTRON_API_KEY=replace-me

GEMMA_MODEL=replace-me
GEMMA_DEPLOYMENT_ID=gemma-deployment-v1
GEMMA_BASE_URL=http://127.0.0.1:8002/v1
GEMMA_API_KEY=replace-me

MINISTRAL_MODEL=ministral-3-14b-instruct-2512
MINISTRAL_DEPLOYMENT_ID=ministral-3-14b-instruct-2512-deployment-v1
MINISTRAL_BASE_URL=http://127.0.0.1:3006/v1
MINISTRAL_API_KEY=replace-me

QWEN_MODEL=replace-me
QWEN_DEPLOYMENT_ID=qwen-deployment-v1
QWEN_BASE_URL=http://127.0.0.1:8003/v1
QWEN_API_KEY=replace-me

# Optional semantic-diversity endpoint. Only generated question text is sent.
# NVIDIA's llama-nemotron-embed-1b-v2 requires input_type=query for this use.
EMBEDDING_BASE_URL=https://integrate.api.nvidia.com/v1/embeddings
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-1b-v2
EMBEDDING_API_KEY=replace-me
# A previously-issued EMBEDDING_API_KEY was exposed in a conversation session
# and must be rotated with the credential issuer before reuse. After you
# rotate the key above, set this to 1 to confirm rotation; embeddings
# functionality refuses to run otherwise. Leave at 0 for a fresh unrotated key.
EMBEDDING_CREDENTIAL_ROTATED=0

# OCR role. The initial command is Chandra, but the served model name is not fixed.
OCR_MODEL=datalab-to/chandra-ocr-2
OCR_BASE_URL=http://127.0.0.1:8001/v1
OCR_API_KEY=replace-me
OCR_OUTPUT_DIR=data/interim/ocr
OCR_COMMAND=chandra
